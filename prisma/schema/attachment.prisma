model Attachment {
  id       String  @id @default(uuid())
  taskId   String
  userId   String
  fileName String
  fileUrl  String
  publicId String?
  mimeType String?
  size     Int?

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@index([taskId])
  @@index([userId])
  @@map("attachments")
}
