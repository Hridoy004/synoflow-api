<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Organization invitation</title>
  </head>
  <body
    style="
      margin: 0;
      padding: 32px 16px;
      background: #f4f8ff;
      color: #122033;
      font-family: Arial, Helvetica, sans-serif;
    "
  >
    <div
      style="
        max-width: 620px;
        margin: 0 auto;
        padding: 32px;
        background: #ffffff;
        border: 1px solid #e3ebf6;
        border-radius: 12px;
      "
    >
      <h1 style="margin: 0 0 16px">
        You are invited to join <%= organizationName %>
      </h1>
      <p style="font-size: 16px; line-height: 1.6; color: #4b5d78">
        Someone invited you to collaborate with their organization on Synoflow.
      </p>
      <p style="margin: 28px 0">
        <a
          href="<%= invitationUrl %>"
          style="
            display: inline-block;
            padding: 13px 20px;
            color: #ffffff;
            background: #1d4ed8;
            border-radius: 6px;
            text-decoration: none;
          "
          >Accept invitation</a
        >
      </p>
      <p style="font-size: 13px; line-height: 1.5; color: #70819c">
        This invitation expires in <%= expirationDays %> days and can only be
        accepted by the invited email address.
      </p>
    </div>
  </body>
</html>
