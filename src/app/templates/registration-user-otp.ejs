<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Verify Your Synoflow Account</title>
    <style>
      body {
        margin: 0;
        padding: 0;
        font-family: Arial, Helvetica, sans-serif;
        background: linear-gradient(180deg, #f4f8ff 0%, #eef3f9 100%);
        color: #122033;
      }
      .wrapper {
        width: 100%;
        background: linear-gradient(180deg, #f4f8ff 0%, #eef3f9 100%);
        padding: 40px 16px;
      }
      .container {
        max-width: 620px;
        margin: 0 auto;
        background: #ffffff;
        border: 1px solid #e3ebf6;
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 16px 40px rgba(18, 32, 51, 0.08);
      }
      .header {
        background: linear-gradient(135deg, #0f172a 0%, #1d4ed8 100%);
        padding: 28px 32px 20px;
        text-align: center;
      }
      .brand {
        font-size: 30px;
        font-weight: 700;
        letter-spacing: 0.6px;
        color: #ffffff;
      }
      .brand small {
        font-size: 12px;
        opacity: 0.9;
        font-weight: 500;
        letter-spacing: 2px;
        display: block;
        margin-top: 6px;
        text-transform: uppercase;
      }
      .content {
        padding: 32px 32px 24px;
      }
      h1 {
        margin: 0 0 14px;
        font-size: 30px;
        line-height: 1.2;
        color: #122033;
      }
      p {
        margin: 0 0 18px;
        font-size: 16px;
        line-height: 1.7;
        color: #4b5d78;
      }
      .email-tag {
        display: inline-block;
        background: #edf4ff;
        color: #1d4ed8;
        font-weight: 700;
        padding: 8px 12px;
        border-radius: 999px;
        font-size: 13px;
        margin: 8px 0 20px;
      }
      .otp-box {
        margin: 26px 0;
        padding: 22px 18px;
        border-radius: 14px;
        background: linear-gradient(135deg, #edf4ff 0%, #e8f5ff 100%);
        border: 1px solid #d4e6ff;
        text-align: center;
      }
      .otp-label {
        display: block;
        font-size: 12px;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        font-weight: 700;
        color: #3167d6;
        margin-bottom: 10px;
      }
      .otp {
        display: inline-block;
        letter-spacing: 10px;
        font-size: 36px;
        font-weight: 700;
        color: #10213d;
      }
      .note {
        background: #f8fafc;
        border-left: 4px solid #2563eb;
        padding: 14px 16px;
        border-radius: 10px;
        color: #47607e;
        font-size: 14px;
      }
      .footer {
        padding: 18px 32px 30px;
        text-align: center;
        color: #70819c;
        font-size: 12px;
      }
      @media (max-width: 620px) {
        .content,
        .footer,
        .header {
          padding-left: 20px;
          padding-right: 20px;
        }
        .otp {
          letter-spacing: 6px;
          font-size: 30px;
        }
      }
    </style>
  </head>
  <body>
    <div class="wrapper">
      <div class="container">
        <div class="header">
          <div class="brand">Synoflow <small>Verify your email</small></div>
        </div>

        <div class="content">
          <h1>Welcome to Synoflow</h1>
          <p>Hello <strong><%= name %></strong>,</p>
          <p>
            Thanks for creating your Synoflow account. To complete your setup,
            verify your email address below.
          </p>
          <div class="email-tag"><%= email %></div>

          <div class="otp-box">
            <span class="otp-label">Verification code</span>
            <div class="otp"><%= otp %></div>
          </div>

          <div class="note">
            This code expires in
            <strong><%= expirationMinutes %> minutes</strong>. If you did not
            create this account, you can safely ignore this email.
          </div>
        </div>

        <div class="footer">
          © 2026 Synoflow. All rights reserved.<br />
          Built for efficient, modern teamwork.
        </div>
      </div>
    </div>
  </body>
</html>
